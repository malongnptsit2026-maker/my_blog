<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Edit Post – Simple Blog</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <div class="container">
    <header>
      <h1>✏️ Edit Post</h1>
      <p>Update your post below</p>
    </header>

    <form action="/edit/<%= post.id %>" method="POST" class="post-form">
      <div class="form-group">
        <label for="title">Title</label>
        <input type="text" id="title" name="title"
          value="<%= post.title %>" required />
      </div>

      <div class="form-group">
        <label for="content">Content</label>
        <textarea id="content" name="content" rows="6" required><%= post.content %></textarea>
      </div>

      <div class="btn-group">
        <button type="submit" class="btn btn-primary">Update Post</button>
        <a href="/" class="btn btn-secondary">Cancel</a>
      </div>
    </form>

    <footer>
      <p>Simple Blog — built with Node, Express &amp; EJS</p>
    </footer>
  </div>
</body>
</html>